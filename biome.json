{
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "scripts/**",
      "scanner/**",
      "*.json",
      "*.jsonc",
      "!!old",
      "!!node_modules"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "javascript": { "formatter": { "quoteStyle": "double" } }
}
