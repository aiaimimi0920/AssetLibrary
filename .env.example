# Copy to .env only for local development. Generate long random values; do not
# reuse these credentials outside the local Docker network.
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
OPENSEARCH_INITIAL_ADMIN_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
ASSETLIBRARY_S3_ENDPOINT=http://127.0.0.1:9100
ASSETLIBRARY_S3_REGION=us-east-1
ASSETLIBRARY_QUARANTINE_BUCKET=assetlibrary-quarantine
ASSETLIBRARY_PUBLISHED_BUCKET=assetlibrary-published
ASSETLIBRARY_CLAMAV_ADDRESS=127.0.0.1:3310
ASSETLIBRARY_APP_UPDATES_ENABLED=false
ASSETLIBRARY_ACCOUNT_SESSION_URL=
ASSETLIBRARY_ACCOUNT_SESSION_COOKIE=neuro_session
ASSETLIBRARY_ACCOUNT_LOGIN_URL=
# Browser origins allowed to call local MinIO. Production config belongs at the
# object-store/CDN layer and must use exact HTTPS origins instead.
ASSETLIBRARY_BROWSER_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:18109
# Origins from which the web server accepts presigned object-store URLs.
ASSETLIBRARY_UPLOAD_ORIGINS=http://127.0.0.1:9100
ASSETLIBRARY_PUBLIC_DOWNLOAD_BASE_URL=http://127.0.0.1:8787
ASSETLIBRARY_RESTRICTED_DOWNLOAD_BASE_URL=http://127.0.0.1:8787
ASSETLIBRARY_DOWNLOAD_TICKET_ISSUER=assetlibrary-local
ASSETLIBRARY_DOWNLOAD_TICKET_AUDIENCE=assetlibrary-edge-local
ASSETLIBRARY_DOWNLOAD_TICKET_SECRET_BASE64=
ASSETLIBRARY_DOWNLOAD_TICKET_TTL_SECONDS=300
ASSETLIBRARY_OPENSEARCH_URL=https://127.0.0.1:9200
ASSETLIBRARY_OPENSEARCH_USERNAME=admin
ASSETLIBRARY_OPENSEARCH_PASSWORD=
ASSETLIBRARY_OPENSEARCH_ALLOW_INVALID_CERTS=true
ASSETLIBRARY_VALKEY_URL=
ASSETLIBRARY_SEARCH_ALIAS=assetlibrary-packages
