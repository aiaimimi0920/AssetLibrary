From 364526c74f8fdb961326ae89a2ac19d291a521e4 Mon Sep 17 00:00:00 2001
From: Valerie Snyder <valsnyde@cisco.com>
Date: Wed, 19 Aug 2026 14:04:07 -0400
Subject: [PATCH] libclamav: Validate 7z folder pack stream ranges

A malformed 7z archive can declare fewer entries in its archive-wide
PackSizes array than a folder coder graph consumes. The extraction path
previously verified only that the folder starting stream existed, allowing
BCJ2 decoding to read past the end of PackSizes.

Validate aggregate folder pack stream ranges while parsing StreamsInfo.
Reject archives whose folder graph consumes more pack streams than were
declared, matching the invariant enforced by current upstream 7-Zip. This
protects both archive extraction and encoded-header decoding.

Reported by Nebula Security.

CLAM-3065
---
 libclamav/7z/7zIn.c | 23 ++++++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

diff --git a/libclamav/7z/7zIn.c b/libclamav/7z/7zIn.c
index 646c4a1a1c..c58a783067 100644
--- a/libclamav/7z/7zIn.c
+++ b/libclamav/7z/7zIn.c
@@ -897,6 +897,27 @@ static SRes SzReadSubStreamsInfo(
 }
 
 
+/**
+ * Validate that every folder's packed-stream range is contained in PackSizes.
+ */
+static SRes SzAr_CheckPackStreams(const CSzAr *p)
+{
+  UInt32 i;
+  UInt32 packStreamIndex = 0;
+
+  for (i = 0; i < p->NumFolders; i++)
+  {
+    const UInt32 numPackStreams = p->Folders[i].NumPackStreams;
+
+    if (numPackStreams > p->NumPackStreams - packStreamIndex)
+      return SZ_ERROR_ARCHIVE;
+
+    packStreamIndex += numPackStreams;
+  }
+
+  return SZ_OK;
+}
+
 static SRes SzReadStreamsInfo(
     CSzData *sd,
     UInt64 *dataOffset,
@@ -917,7 +938,7 @@ static SRes SzReadStreamsInfo(
     switch((int)type)
     {
       case k7zIdEnd:
-        return SZ_OK;
+        return SzAr_CheckPackStreams(p);
       case k7zIdPackInfo:
       {
         RINOK(SzReadPackInfo(sd, dataOffset, &p->NumPackStreams,
