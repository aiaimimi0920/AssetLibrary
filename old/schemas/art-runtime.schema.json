{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetlibrary.neuro.local/schemas/art-runtime.schema.json",
  "title": "Loom Art runtime manifest v1",
  "type": "object",
  "required": ["protocolVersion", "entry"],
  "properties": {
    "protocolVersion": { "const": "loom.art.runtime.v1" },
    "entry": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "$ref": "#/$defs/relativeCommand" },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 4096 }
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["timeoutMs", "maxStdoutBytes", "maxStderrBytes", "maxProcesses"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxStdoutBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "maxStderrBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "maxProcesses": { "type": "integer", "minimum": 1, "maximum": 16 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "relativeCommand": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    }
  },
  "additionalProperties": false
}
