{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetlibrary.neuro.local/schemas/manifest-base.schema.json",
  "title": "AssetLibrary manifest base",
  "type": "object",
  "required": ["schema_version", "package", "release", "artifact"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "kind"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,119}$" },
        "kind": { "enum": ["art", "capability", "app_update"] }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "compatibility"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["products"],
          "properties": {
            "products": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "version_requirement"],
                "properties": {
                  "name": { "enum": ["loom", "hook"] },
                  "version_requirement": { "type": "string", "minLength": 1, "maxLength": 100 }
                }
              }
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "size_bytes", "digest"],
      "properties": {
        "file_name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
