ARG RUST_IMAGE=rust@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1
ARG RUNTIME_IMAGE=gcr.io/distroless/cc-debian12@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f

FROM ${RUST_IMAGE} AS build
WORKDIR /src
ARG SOURCE_COMMIT
ARG SOURCE_URL
RUN test "${#SOURCE_COMMIT}" -eq 40 && \
    case "${SOURCE_COMMIT}" in *[!0-9a-f]*) exit 1 ;; esac && \
    case "${SOURCE_URL}" in https://*) ;; *) exit 1 ;; esac
COPY . .
RUN cargo build --locked --release --package assetlibrary-api --bin assetlibrary-api && \
    cargo build --locked --release --package assetlibrary-scanner-worker --bin assetlibrary-scanner-worker && \
    cargo build --locked --release --package assetlibrary-outbox-worker --bin assetlibrary-outbox-worker && \
    cargo build --locked --release --package assetlibrary-indexer-worker --bin assetlibrary-indexer-worker && \
    cargo build --locked --release --package assetlibrary-cleanup-worker --bin assetlibrary-cleanup-worker

FROM ${RUNTIME_IMAGE} AS runtime
ARG SOURCE_COMMIT
ARG SOURCE_URL
ARG VERSION
LABEL org.opencontainers.image.title="Neuro AssetLibrary PC2 services" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.source="${SOURCE_URL}"
WORKDIR /app
COPY --from=build /src/target/release/assetlibrary-api /app/assetlibrary-api
COPY --from=build /src/target/release/assetlibrary-scanner-worker /app/assetlibrary-scanner-worker
COPY --from=build /src/target/release/assetlibrary-outbox-worker /app/assetlibrary-outbox-worker
COPY --from=build /src/target/release/assetlibrary-indexer-worker /app/assetlibrary-indexer-worker
COPY --from=build /src/target/release/assetlibrary-cleanup-worker /app/assetlibrary-cleanup-worker
USER nonroot:nonroot
